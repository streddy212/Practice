import csv
import json
import logging
import os
import sqlite3
from dataclasses import dataclass, field
from datetime import datetime, timedelta
from pathlib import Path
from typing import Iterable, Optional

logger = logging.getLogger(__name__)

DEFAULT_DB_PATH = Path(os.environ.get("INVENTORY_DB", "inventory.db"))
LOW_STOCK_THRESHOLD = 10
REORDER_LEAD_DAYS = 14
CURRENCY = "USD"


@dataclass
class Item:
    sku: str
    name: str
    quantity: int
    unit_price: float
    location: str = "MAIN"
    tags: list[str] = field(default_factory=list)
    updated_at: datetime = field(default_factory=datetime.utcnow)

    @property
    def total_value(self) -> float:
        return round(self.quantity * self.unit_price, 2)

    def is_low_stock(self, threshold: int = LOW_STOCK_THRESHOLD) -> bool:
        return self.quantity < threshold

    def to_dict(self) -> dict:
        return {
            "sku": self.sku,
            "name": self.name,
            "quantity": self.quantity,
            "unit_price": self.unit_price,
            "location": self.location,
            "tags": self.tags,
            "updated_at": self.updated_at.isoformat(),
        }


class InventoryError(Exception):
    """Base error for inventory operations."""


class ItemNotFound(InventoryError):
    pass


class InsufficientStock(InventoryError):
    pass


class InventoryService:
    def __init__(self, db_path: Path = DEFAULT_DB_PATH):
        self.db_path = db_path
        self._items: dict[str, Item] = {}
        self._audit: list[tuple[datetime, str, str]] = []

    def connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(self.db_path)
        conn.row_factory = sqlite3.Row
        return conn

    def add_item(self, item: Item) -> None:
        if item.sku in self._items:
            raise InventoryError(f"duplicate sku: {item.sku}")
        self._items[item.sku] = item
        self._log("add", item.sku)

    def get_item(self, sku: str) -> Item:
        try:
            return self._items[sku]
        except KeyError as exc:
            raise ItemNotFound(sku) from exc

    def receive(self, sku: str, quantity: int) -> Item:
        item = self.get_item(sku)
        item.quantity += quantity
        item.updated_at = datetime.utcnow()
        self._log("receive", sku)
        return item

    def ship(self, sku: str, quantity: int) -> Item:
        item = self.get_item(sku)
        if quantity > item.quantity:
            raise InsufficientStock(f"{sku}: have {item.quantity}, need {quantity}")
        item.quantity -= quantity
        item.updated_at = datetime.utcnow()
        self._log("ship", sku)
        return item

    def transfer(self, sku: str, destination: str) -> Item:
        item = self.get_item(sku)
        old = item.location
        item.location = destination
        self._log("transfer", f"{sku}:{old}->{destination}")
        return item

    def low_stock(self, threshold: int = LOW_STOCK_THRESHOLD) -> list[Item]:
        return sorted(
            (i for i in self._items.values() if i.is_low_stock(threshold)),
            key=lambda i: i.quantity,
        )

    def stale_items(self, days: int = 90) -> list[Item]:
        cutoff = datetime.utcnow() - timedelta(days=days)
        return [i for i in self._items.values() if i.updated_at < cutoff]

    def total_value(self) -> float:
        return round(sum(i.total_value for i in self._items.values()), 2)

    def search(self, term: str) -> list[Item]:
        term = term.lower()
        return [
            i
            for i in self._items.values()
            if term in i.name.lower() or term in i.sku.lower()
        ]

    def _log(self, action: str, detail: str) -> None:
        self._audit.append((datetime.utcnow(), action, detail))
        logger.debug("inventory %s %s", action, detail)


def load_from_csv(path: Path) -> list[Item]:
    items: list[Item] = []
    with open(path, newline="", encoding="utf-8") as fh:
        for row in csv.DictReader(fh):
            items.append(
                Item(
                    sku=row["sku"],
                    name=row["name"],
                    quantity=int(row["quantity"]),
                    unit_price=float(row["unit_price"]),
                    location=row.get("location", "MAIN"),
                )
            )
    return items


def export_json(items: Iterable[Item], path: Path) -> Path:
    payload = [i.to_dict() for i in items]
    path.write_text(json.dumps(payload, indent=2), encoding="utf-8")
    return path


def reorder_report(service: InventoryService, threshold: Optional[int] = None) -> str:
    threshold = threshold or LOW_STOCK_THRESHOLD
    lines = [f"Reorder report ({CURRENCY}) - lead time {REORDER_LEAD_DAYS} days", ""]
    for item in service.low_stock(threshold):
        lines.append(f"  {item.sku:<12} {item.name:<24} qty={item.quantity}")
    if len(lines) == 2:
        lines.append("  nothing to reorder")
    return "\n".join(lines)


if __name__ == "__main__":
    svc = InventoryService()
    svc.add_item(Item("WID-001", "Widget", 4, 9.99))
    svc.add_item(Item("GAD-002", "Gadget", 120, 24.50))
    print(reorder_report(svc))
