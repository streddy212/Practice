# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real credentials.

# Your Gmail address. The digest emails itself to this address.
DIGEST_EMAIL_ADDRESS=youraddress@gmail.com

# A Gmail App Password (NOT your normal password). Generate one at
# https://myaccount.google.com/apppasswords -- requires 2-Step
# Verification to be turned on for your Google account first.
DIGEST_EMAIL_APP_PASSWORD=your-16-character-app-password
